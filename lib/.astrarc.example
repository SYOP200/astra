# Astra Shell Configuration

[general]
theme = "crimson"
startup_message = true
update_check = true
telemetry = false


[prompt]
show_user = true
show_hostname = true
show_directory = true
show_git = true
show_time = true
symbol = "❯"


[history]
enabled = true
file = "~/.astra_history"
size = 10000
deduplicate = true
ignore_duplicates = true


[completion]
enabled = true
case_sensitive = false
show_hidden_files = false
max_results = 20


[behavior]
confirm_exit = true
allow_scripts = true
auto_cd = false
vi_mode = false


[aliases]

# Navigation
home = "cd ~"
.. = "cd .."
... = "cd ../.."

# File management
ll = "ls -lah"
la = "ls -a"
l = "ls"

# Git
gs = "git status"
ga = "git add"
gc = "git commit"
gp = "git push"
gpl = "git pull"
gd = "git diff"
gl = "git log --oneline"

# Rust
cb = "cargo build"
cr = "cargo run"
ct = "cargo test"
cc = "cargo clean"

# System
c = "clear"
reload = "astra reload"

# Development
serve = "python3 -m http.server"
ports = "lsof -i"


[plugins]
enabled = true
directory = "~/.astra/plugins"


[appearance]
unicode = true
nerd_fonts = true
animations = true
compact = false
